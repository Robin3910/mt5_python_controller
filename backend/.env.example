# ---- infra ----
REDIS_URL=redis://localhost:6379/0
# Local dev (no MySQL needed):
# MYSQL_DSN=sqlite+aiosqlite:///./mt5hub.db
# Production (MySQL):
MYSQL_DSN=mysql+asyncmy://mt5:mt5pwd@mysql:3306/mt5hub

# ---- webhook auth (TradingView) ----
# 未在配置页保存过时生效；配置页「Webhook 校验 token」保存后以数据库为准。默认开启。
ENABLE_AUTH=true
AUTH_TOKEN=change_me_webhook_token
ENABLE_IP_WHITELIST=false
WHITELISTED_IPS=52.89.214.238,34.212.75.30,54.218.53.128,52.32.178.7

# ---- admin auth ----
JWT_SECRET=please_change_this_secret
JWT_EXPIRE_MINUTES=720
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# ---- 阿里云短信认证（手机号注册 / 验证码登录）----
# 密钥只从 env 读，不入库、不回显。生产环境由 K8s Secret 注入，不要写进本文件。
# 获取路径：阿里云控制台 → 访问控制 RAM → 身份管理 → 用户 → 创建用户
#   （访问方式勾选「使用永久 AccessKey 访问」），创建后立即显示 AccessKey ID / Secret（只显示一次）。
# 建议用只授予 dypns:SendSmsVerifyCode 的 RAM 子账号，不要用主账号密钥：
#   新建自定义权限策略，Action 填 dypns:SendSmsVerifyCode，Resource 填 *，再授权给该用户。
# 签名与模板不在这里配 —— 在本系统「配置 → 短信服务」页填（来自阿里云号码认证控制台的
# 「赠送签名配置」与「赠送模板配置」页面）。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 阿里云验证码 2.0 的加密密钥（ekey）：Base64 编码的 32 字节 AES 密钥，
# 从「验证码控制台 → 概览页右上角」获取。配了它就启用「加密模式」
# （服务端动态生成 EncryptedSceneId，防 SceneId 泄露被白嫖额度）。
# 留空 = 非加密模式。注意：验证码与号码认证是两个独立产品，需分别开通。
ALIYUN_CAPTCHA_EKEY=
# 验证码哈希盐（缺省退回 JWT_SECRET）。轮换 JWT_SECRET 时可单独换它而不让存量验证码失效。
# 自己生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
SMS_CODE_SALT=

# ---- websocket / intervals (seconds) ----
HEARTBEAT_INTERVAL=30
ONLINE_TTL=90
ACCOUNT_REPORT_INTERVAL=5
AUTH_FIRST_PACKET_TIMEOUT=5

# ---- dispatch ----
POSITION_SCOPE=symbol
DISPATCH_MODE=sync
POLL_ACK_TIMEOUT=15
POLL_MAX_RETRY=3
DEDUP_WINDOW=5

# ---- client version management ----
# 客户端安装包存放目录（容器内路径需与 docker-compose 的 backend_data 卷对应）
CLIENT_PACKAGE_DIR=./data/client_packages
CLIENT_PACKAGE_MAX_MB=300

LOG_LEVEL=INFO
