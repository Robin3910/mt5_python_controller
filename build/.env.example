# ===== docker-compose environment (copy to .env) =====

# ---- nginx 对外端口（两个 compose 文件均读取；未设置时 Linux 默认 80/443，Windows 默认 8080/8443）----
# Windows 上 80/443 常被 IIS/HTTP.sys 占用，默认改用 8080/8443；要用 80/443 直接改这里。
HTTP_PORT=59188
HTTPS_PORT=59186

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=mt5hub
MYSQL_USER=mt5hub
MYSQL_PASSWORD=Uk7sjJl4UkhocPNWCPhocPNWCP

# ---- admin login ----
JWT_SECRET=7sjJl4Uk7sjJl4UkhocPNWCPhocPNWCP
JWT_EXPIRE_MINUTES=720
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# ---- 阿里云短信认证（手机号注册 / 验证码登录）----
# AccessKey 从阿里云 RAM 控制台「身份与权限 → 用户 → AccessKey」获取；
# 建议用只授予 dypnsapi:SendSmsVerifyCode 的 RAM 子账号，不要用主账号密钥。
# 密钥只放这里（compose 的 env_file），不要提交进仓库。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 阿里云验证码 2.0 的加密密钥（ekey）：Base64 编码的 32 字节 AES 密钥，
# 从「验证码控制台 → 概览页右上角」获取。
# 配了它就启用「加密模式」：服务端用 ekey 动态生成 EncryptedSceneId，
# 前端拿不到明文 SceneId —— 防止别人抄走你的 SceneId 白嫖你的验证码额度。
# 留空 = 非加密模式（SceneId 明文下发）。
# 注意：阿里云验证码与号码认证是两个独立产品，需分别开通与计费。
ALIYUN_CAPTCHA_EKEY=
# 验证码哈希盐：自己生成的随机串，缺省退回 JWT_SECRET。
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SMS_CODE_SALT=

# ---- TradingView webhook auth ----
ENABLE_AUTH=true
AUTH_TOKEN=7sjJl4UkhocPNWCP
ENABLE_IP_WHITELIST=false
WHITELISTED_IPS=52.89.214.238,34.212.75.30,54.218.53.128,52.32.178.7

# ---- websocket / intervals (seconds) ----
HEARTBEAT_INTERVAL=30
ONLINE_TTL=90
ACCOUNT_REPORT_INTERVAL=5
AUTH_FIRST_PACKET_TIMEOUT=5

# ---- dispatch ----
POSITION_SCOPE=symbol
DISPATCH_MODE=sync
POLL_ACK_TIMEOUT=15
POLL_MAX_RETRY=3
DEDUP_WINDOW=5

LOG_LEVEL=INFO

# ---- Docker 后端构建（可选）----
# 国内服务器默认走腾讯云 PyPI，避免 files.pythonhosted.org 读超时。
# 阿里云备用：
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
# PIP_TRUSTED_HOST=mirrors.aliyun.com
PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple
PIP_TRUSTED_HOST=mirrors.cloud.tencent.com
# Clash / FlClash TUN fake-ip 导致容器访问不了外网时，复用本机已有后端镜像、跳过 pip：
# BACKEND_FROM=mt5hub-server-backend:latest
# INSTALL_DEPS=0

# ---- frontend（构建 nginx 镜像时写入静态资源，改完需重新 build nginx）----
# 留空 = 浏览器走同源，由 nginx 反代 /api。本地前端要连远程后端时填完整 origin。
# VITE_API_BASE=https://hub.example.com
VITE_API_BASE=
