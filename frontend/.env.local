# 本地开发：把 VITE_API_BASE 指向线上后端的公网地址
# 留空 = 走同源（同部署下的 nginx 反代），通常生产环境是这样
# 本地连线上时：填线上后端的完整 origin，例如：
#   VITE_API_BASE=https://hub.example.com
#   VITE_API_BASE=http://1.2.3.4:8000
#
# 重要：浏览器同源策略会拦截跨域请求，请二选一：
#   1) 给浏览器装一个 CORS 解除扩展（开发期最快）
#   2) 在线上 FastAPI 后端加 CORSMiddleware 允许 http://localhost:5173
VITE_API_BASE=http://49.234.182.6/
