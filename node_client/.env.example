# ============ 后端连接 ============
# 后端网关 WebSocket 地址；节点通过它接收交易指令、上报状态。
# 本地开发用 ws://；生产经 nginx/TLS 时改成 wss://hub.example.com/ws/node
MANAGER_WS_URL=ws://159.75.33.185/ws/node
# 节点鉴权令牌：后端 POST /api/nodes 新建节点时返回的一次性 token，握手时校验
NODE_TOKEN=vlq8iAXw3cJcj0laJJ0dvVDDj6GH_YUho5vosh48ggk

# MT5_LOGIN / MT5_PASSWORD / MT5_SERVER：终端已登录则自动复用，无需输入；
# 未登录时启动交互输入。客户端须放在 MetaTrader 5 安装目录（与 terminal64.exe 同目录）。
# Set true to run without a real MT5 terminal (dev/testing)
MT5_MOCK=false

# timings (seconds)
HEARTBEAT_INTERVAL=15
# 账户/持仓快照上报间隔（秒，支持小数，下限 0.05）：越小余额/持仓刷新越快，MT5 调用越频繁
ACCOUNT_REPORT_INTERVAL=0.5
RECONNECT_MIN=2
RECONNECT_MAX=30
AUTH_TIMEOUT=10

# trading
# 本地额外观察列表；中控台「多区间方向过滤」已配置品种会在鉴权后自动下发并合并取价
WATCH_SYMBOLS=XAUUSD
DEFAULT_SLIPPAGE=20
DEFAULT_MAGIC=20240615

# 策略监控事件总线：MT5 无推送接口，事件由统一采样生成
# 采样间隔（秒，下限 0.05）：越小加仓判定越及时，MT5 调用越频繁
STRATEGY_SAMPLE_INTERVAL=0.5
# 无变化时的保活事件间隔（秒），决定运行期快照上报节奏
STRATEGY_IDLE_INTERVAL=5
# 判定持仓已全平所需的连续确认轮数，用于容忍 MT5 偶发返回不完整持仓
STRATEGY_EMPTY_CONFIRM=2

LOG_LEVEL=INFO

# 本机运维面板状态口（仅绑 127.0.0.1；0=关闭。面板启动实例时会注入可用端口）
LOCAL_STATUS_HOST=127.0.0.1
LOCAL_STATUS_PORT=0
